# 复制为项目根目录 .env；真实值不要提交、不要写入 YAML。
MODEL_API_KEY=                       # 必填：真实模型服务的 API Key
MODEL_BASE_URL=                      # 官方 OpenAI 留空；兼容服务填写完整 /v1 地址
ANTHROPIC_API_KEY=                   # provider=anthropic 时必填：Anthropic API Key
ANTHROPIC_BASE_URL=                  # Anthropic 官方接口留空；代理/模拟服务才填写
AGENTLOOM_CONFIG=config.yaml         # 可选：指定配置文件，默认就是根目录 config.yaml
